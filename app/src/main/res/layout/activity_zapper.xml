<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@color/mainbgcolor"
    tools:context="com.photofusion.holi.videomaker.photo.slideshow.swap.SwapperActivity">


    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp">


        <ImageView
            android:id="@+id/back"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_10sdp"
            android:src="@drawable/btnback"
            app:tint="@color/toptextcolor" />


        <ImageView
            android:id="@+id/done"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/_12sdp"
            android:src="@drawable/pdone"
            app:tint="@color/toptextcolor" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Swap Images"
            android:textStyle="bold"
            android:textColor="@color/toptextcolor"
            android:textSize="@dimen/_14sdp" />


    </RelativeLayout>


    <com.photofusion.holi.videomaker.photo.slideshow.gridsupport.AbsDynamicGridView
        android:id="@+id/dynamicGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header"
        android:layout_margin="@dimen/_10sdp"
        android:layout_above="@+id/adLyt"
        android:verticalSpacing="@dimen/_15sdp"
        android:horizontalSpacing="@dimen/_15sdp"
        android:numColumns="2"/>

    <LinearLayout
        android:layout_alignParentBottom="true"
        android:id="@+id/adLyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/banner_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>
</RelativeLayout>