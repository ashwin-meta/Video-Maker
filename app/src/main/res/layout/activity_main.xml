<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:padding="@dimen/_20sdp"
    android:background="@drawable/main_bg"
    tools:context="com.photofusion.holi.videomaker.photo.slideshow.MainActivity">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

    <LinearLayout
        android:layout_above="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1">



            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                >

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/_140sdp"
                    android:layout_height="@dimen/_140sdp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/sp_logo" />


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@id/container">


                    <RelativeLayout
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="250dp"
                            android:id="@+id/adFrameLayout">

                            <ProgressBar
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:id="@+id/adProgress"/>
                        </FrameLayout>
                    </RelativeLayout>


                    <com.facebook.ads.NativeAdLayout
                        android:id="@+id/native_ad_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />


                </RelativeLayout>


            </RelativeLayout>


        <LinearLayout
            android:id="@+id/btnLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
               >


                <LinearLayout
                    android:layout_marginTop="@dimen/_10sdp"
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_160sdp"
                    android:background="@drawable/slide_press"
                    android:gravity="center"
                    android:orientation="horizontal">



                </LinearLayout>

                <LinearLayout

                    android:layout_marginTop="@dimen/_10sdp"
                    android:id="@+id/btnAllVideo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_150sdp"
                    android:background="@drawable/creation_press"
                    android:gravity="center"
                    android:orientation="horizontal">


                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:id="@+id/remove_ads"
                    android:layout_width="@dimen/_260sdp"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:cardCornerRadius="@dimen/_40sdp">


                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_15sdp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:text="Vip Offers"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sdp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="100% remove all Ads \nfrom application"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_10sdp" />


                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            app:cardCornerRadius="@dimen/_20sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Get Now"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </androidx.cardview.widget.CardView>


                    </LinearLayout>


                    <ImageView

                        android:layout_width="@dimen/_130sdp"
                        android:layout_height="@dimen/_120sdp"
                        android:layout_gravity="right|center"
                        android:src="@drawable/remove_ad" />


                </androidx.cardview.widget.CardView>

                <RelativeLayout
                    android:id="@+id/btn_rateme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <ImageView

                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_50sdp"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:src="@drawable/ratee"
                        android:translationZ="@dimen/_10sdp" />

                    <androidx.cardview.widget.CardView

                        android:layout_width="@dimen/_260sdp"
                        android:layout_height="@dimen/_150sdp"
                        android:layout_centerInParent="true"
                        app:cardCornerRadius="@dimen/_40sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/card_bg"
                            android:gravity="center"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_15sdp"

                                android:gravity="center"
                                android:text="Rate Us"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_20sdp"
                                android:textStyle="bold" />


                        </LinearLayout>


                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_200sdp"
                    >



                    <RelativeLayout
                        android:id="@+id/container1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/adFrameLayout1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="250dp">

                            <ProgressBar
                                android:id="@+id/adProgress1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center" />
                        </FrameLayout>
                    </RelativeLayout>


                    <com.facebook.ads.NativeAdLayout
                        android:id="@+id/native_ad_container1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.12"
                android:gravity="center"
                android:paddingTop="@dimen/_5sdp">


                <androidx.cardview.widget.CardView
                    android:id="@+id/rateIV"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_45sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    >

                    <RelativeLayout
                        android:layout_gravity="center_vertical"
                        android:layout_margin="@dimen/_2sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/cross_bg"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        >


                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.7"
                            android:padding="@dimen/_3sdp"
                            android:src="@drawable/d_rate_btn"

                            app:tint="@color/white"
                            />


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.3"
                            android:text="Rate US"
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:gravity="center"

                            />




                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/shareIV"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_45sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    >

                    <RelativeLayout
                        android:layout_gravity="center_vertical"
                        android:layout_margin="@dimen/_2sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/cross_bg"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        >


                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.7"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/d_share_btn"

                            app:tint="@color/white"
                            />


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.3"
                            android:text="Share"
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:gravity="center"

                            />




                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.12"
                android:gravity="center"
                android:paddingTop="@dimen/_5sdp">


                <androidx.cardview.widget.CardView
                    android:id="@+id/privacyIV"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_45sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    >

                    <RelativeLayout
                        android:layout_gravity="center_vertical"
                        android:layout_margin="@dimen/_2sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/cross_bg"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        >


                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.7"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/d_privacy_btn"

                            app:tint="@color/white"
                            />


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.3"
                            android:text="Privacy \npolicy"
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:gravity="center"

                            />




                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/moreIV"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="@dimen/_45sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    >

                    <RelativeLayout
                        android:layout_gravity="center_vertical"
                        android:layout_margin="@dimen/_2sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/cross_bg"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        >


                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.7"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/moreapps"
                            app:tint="@color/white"
                            />


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.3"
                            android:text="More Apps"
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:gravity="center"

                            />




                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


    </ScrollView>

    <include layout="@layout/ad_banner_lay"/>

</RelativeLayout>